# Kapso (Integrations → API keys + WhatsApp → Phone numbers)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
KAPSO_BASE_URL=https://api.kapso.ai

# URL pública de este backend, sin barra final (ngrok en local, dominio en prod).
# Al derivar, el bot deja la nota en el contacto y arranca el workflow tecnobot-handoff
# (banner amarillo en el inbox). Resume from Handoff pega a /webhooks/kapso/resume
# con el header X-Resume-Secret igual a KAPSO_WEBHOOK_SECRET.
KAPSO_PUBLIC_BASE_URL=
# Opcional. Si está vacío, se crea o reutiliza el workflow con slug tecnobot-handoff.
KAPSO_HANDOFF_WORKFLOW_ID=
# Opcional. Usuario del proyecto Kapso: el hilo se le asigna con la nota del turno.
KAPSO_HANDOFF_USER_ID=

# DeepSeek (compatible con SDK OpenAI). Hace falta a partir del motor LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# El cotizador mecánico busca en la web. Esa tool solo corre en deepseek-v4-pro.
LLM_ESTIMATOR_MODEL=deepseek-v4-pro

# SQLite local. En Render: postgresql:// del session pooler de Supabase
# (puerto 5432, con sslmode=require). Se reescribe a postgresql+psycopg://.
DATABASE_URL=sqlite:///./tecnobot.db

# true = eco, sin LLM. false = DeepSeek (hace falta LLM_API_KEY).
ECHO_MODE=false

# Pesos argentinos por hora de mano de obra. 0 = sin configurar.
# cotizar_mecanica_ia lo usa; no se le pregunta al cliente.
LABOR_HOURLY_RATE_ARS=0

# Margen en % sobre el precio de catálogo de la batería (no hay costo de colocación).
# Precio final al cliente = precio_en_catalogo * (1 + BATTERY_MARGIN_PCT / 100).
BATTERY_MARGIN_PCT=30

# Pesos del cargo de revisión técnica a domicilio de batería.
# Si el problema no es la batería, el cliente abona este importe.
# Si cambia la batería, se descuenta del pago final. 0 = sin configurar.
BATTERY_REVISION_FEE_ARS=0

# Horas que se reutiliza la estimación de cotizar_mecanica_ia para el mismo vehículo y trabajo
# (consultas repetidas dan el mismo número). 0 = sin caché.
ESTIMATE_CACHE_TTL_HOURS=24
